{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_MODE": "ON",
        "ENGINE_ENABLE_LOGGING": "ON",
        "ENGINE_LOG_LEVEL_MIN": "0",
        "ENGINE_LOG_LEVEL_MIN_DEBUG": "0",
        "ENGINE_LOG_LEVEL_MIN_RELEASE": "0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "inherits": "windows-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENGINE_ASSET_ROOT": "${sourceDir}/out/build/${presetName}/bin"
      }
    },
    {
      "name": "x64-asan",
      "displayName": "x64 Debug with MSVC AddressSanitizer",
      "inherits": "x64-debug",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "/fsanitize=address",
        "CMAKE_CXX_FLAGS": "/fsanitize=address"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "inherits": "x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENGINE_ASSET_ROOT": "${sourceDir}/out/build/${presetName}/bin"
      }
    },
    {
      "name": "x64-release-benchmarks",
      "displayName": "x64 Release with Benchmarks",
      "inherits": "x64-release",
      "cacheVariables": {
        "ENGINE_BUILD_BENCHMARKS": "ON",
        "VCPKG_MANIFEST_FEATURES": "benchmarks"
      }
    },
    {
      "name": "x86-debug",
      "displayName": "x86 Debug",
      "inherits": "windows-base",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENGINE_ASSET_ROOT": "${sourceDir}/out/build/${presetName}/bin"
      }
    },
    {
      "name": "x86-release",
      "displayName": "x86 Release",
      "inherits": "x86-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENGINE_ASSET_ROOT": "${sourceDir}/out/build/${presetName}/bin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-release-benchmarks",
      "configurePreset": "x64-release-benchmarks",
      "targets": ["GraphicEngineBenchmarks"]
    }
  ],
  "testPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "x64-debug-unit",
      "displayName": "x64 Debug Unit Tests",
      "configurePreset": "x64-debug",
      "filter": { "include": { "label": "unit" } },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "x64-debug-integration",
      "displayName": "x64 Debug Integration Tests",
      "configurePreset": "x64-debug",
      "filter": { "include": { "label": "integration" } },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "x64-release-benchmarks",
      "displayName": "x64 Release Benchmark Smoke Tests",
      "configurePreset": "x64-release-benchmarks",
      "filter": { "include": { "label": "benchmark" } },
      "output": { "outputOnFailure": true }
    }
  ]
}
