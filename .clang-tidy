# Keep clang-tidy focused on correctness defects and measurable performance issues.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-signed-bitwise,
  performance-*

WarningsAsErrors: 'bugprone-*,performance-*'
HeaderFilterRegex: '.*(GraphicEngineCore|GraphicEngineEditor|GraphicEngineBackends|SandboxApp)/.*'
ExcludeHeaderFilterRegex: '.*(vendor|out|build)/.*'
FormatStyle: file
SystemHeaders: false
