option(ENGINE_ENABLE_LOGGING "Compile engine logging calls" ON)
set(ENGINE_LOG_LEVEL_MIN 0 CACHE STRING "Global cutoff: 0=Trace through 6=None")
set(ENGINE_LOG_LEVEL_MIN_DEBUG "" CACHE STRING "Optional Debug override; empty uses global cutoff")
set(ENGINE_LOG_LEVEL_MIN_RELEASE 2 CACHE STRING "Optional Release/Shipping override")
if(ENGINE_LOG_LEVEL_MIN_DEBUG STREQUAL "")
    set(ENGINE_LOG_LEVEL_MIN_DEBUG_EFFECTIVE "${ENGINE_LOG_LEVEL_MIN}")
else()
    set(ENGINE_LOG_LEVEL_MIN_DEBUG_EFFECTIVE "${ENGINE_LOG_LEVEL_MIN_DEBUG}")
endif()
if(ENGINE_LOG_LEVEL_MIN_RELEASE STREQUAL "")
    set(ENGINE_LOG_LEVEL_MIN_RELEASE_EFFECTIVE "${ENGINE_LOG_LEVEL_MIN}")
else()
    set(ENGINE_LOG_LEVEL_MIN_RELEASE_EFFECTIVE "${ENGINE_LOG_LEVEL_MIN_RELEASE}")
endif()

target_compile_definitions(EngineRuntime PRIVATE
    ENGINE_ENABLE_LOGGING=$<BOOL:${ENGINE_ENABLE_LOGGING}>
    ENGINE_LOG_LEVEL_MIN=$<IF:$<CONFIG:Debug>,${ENGINE_LOG_LEVEL_MIN_DEBUG_EFFECTIVE},${ENGINE_LOG_LEVEL_MIN_RELEASE_EFFECTIVE}>
)
target_compile_definitions(GraphicEngineCore PUBLIC
    ENGINE_ENABLE_LOGGING=$<BOOL:${ENGINE_ENABLE_LOGGING}>
    ENGINE_LOG_LEVEL_MIN=$<IF:$<CONFIG:Debug>,${ENGINE_LOG_LEVEL_MIN_DEBUG_EFFECTIVE},${ENGINE_LOG_LEVEL_MIN_RELEASE_EFFECTIVE}>
)
