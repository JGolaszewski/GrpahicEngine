PROJECT_NAME           = GraphicEngine Core API
OUTPUT_DIRECTORY       = out/docs/doxygen

INPUT                  = GraphicEngineCore/modules
FILE_PATTERNS          = *.h *.hpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */src/* */tests/*
EXCLUDE                = vendor out build

GENERATE_HTML          = NO
HTML_OUTPUT            = html
GENERATE_XML           = YES
XML_OUTPUT             = xml
GENERATE_LATEX          = NO
GENERATE_RTF            = NO
GENERATE_MAN            = NO
GENERATE_DOCSET         = NO

EXTRACT_ALL             = NO
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = NO
HIDE_UNDOC_CLASSES      = YES
HIDE_UNDOC_MEMBERS      = YES
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = NO
WARN_IF_DOC_ERROR       = YES
WARN_AS_ERROR           = NO
QUIET                   = NO

ENABLE_PREPROCESSING    = YES
MACRO_EXPANSION         = NO
PREDEFINED              = ENGINE_API=
SOURCE_BROWSER          = NO
HAVE_DOT                = NO
