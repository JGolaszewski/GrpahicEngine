# =========================
# User Exclusions
# =========================
.vs/
out/
vendor/

# SourceTrail
*.srctrlbm
*.srctrlprj
*.srctrldb

# Documents
*.md
!RESOURCE_MANAGER_IMPLEMENTATION_PLAN.md
!ENGINE_REAUDIT_REPORT_V2.md
!GLTF_IMPLEMENTATION_GAP_REPORT.md
!LOGGING_DEBUGGING_IMPROVEMENT_PLAN.md
!TESTING_IMPLEMENTATION_PROMPT.md
!SPRAWOZDANIE_POSTPROCESSING.md
!ARCHETYPE_ECS_ARCHITECTURE_PLAN.md
!DOCUMENTATION_PIPELINE_PLAN.md
!docs/*.md
!docs/**/*.md
!docs/logging.md

# =========================
# Build & CMake Artifacts
# =========================
build/
bin/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
compile_commands.json

# =========================
# Compiled Binaries & C++ Intermediates
# =========================
*.obj
*.o
*.pdb
*.ilk
*.lib
*.dll
*.exe
*.exp

# =========================
# Visual Studio & IDEs
# =========================
*.user
*.suo
*.db
*.opendb
*.sln.docstates
.vscode/
.cursor/

# =========================
# Graphics Engine & Shaders
# =========================
*.cso            # Compiled Direct3D Shaders (HLSL)
*.spv            # Compiled Vulkan Shaders (SPIR-V)
*.rdc            # RenderDoc capture files
*.crash
*.dmp            # Crash dumps

# =========================
# OpenAI Codex / AI Agents
# =========================
.codex/auth.json  # Codex auth tokens
.codex/worktrees/ # Local Codex background worktrees
.venv-docs/
site/
