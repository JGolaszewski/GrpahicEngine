# =========================
# User Exclusions
# =========================
.vs/
out/
vendor/

# SourceTrail
*.srctrlbm
*.srctrlprj
*.srctrldb

# Markdown files are ignored outside docs/.
*.md
!README.md
!docs/*.md
!docs/**/*.md

# =========================
# Build & CMake Artifacts
# =========================
build/
bin/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
compile_commands.json

# =========================
# Compiled Binaries & C++ Intermediates
# =========================
*.obj
*.o
*.pdb
*.ilk
*.lib
*.dll
*.exe
*.exp

# =========================
# Visual Studio & IDEs
# =========================
*.user
*.suo
*.db
*.opendb
*.sln.docstates
.vscode/
.cursor/

# =========================
# Graphics Engine & Shaders
# =========================
*.cso            # Compiled Direct3D Shaders (HLSL)
*.spv            # Compiled Vulkan Shaders (SPIR-V)
*.rdc            # RenderDoc capture files
*.crash
*.dmp            # Crash dumps

# =========================
# OpenAI Codex / AI Agents
# =========================
.codex/auth.json  # Codex auth tokens
.codex/worktrees/ # Local Codex background worktrees
.venv-docs/
site/
